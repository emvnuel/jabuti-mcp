# jabuti-mcp configuration — copy to datasources.yaml and adjust.
#
# Passwords should always come from the environment via ${VAR} interpolation;
# an unresolved ${VAR} is kept literally, so a typo fails loudly at connect time.
#
# Running the server in a container (see "Docker" in README.md)? Use the
# database's container name when it shares the Docker network, or
# host.docker.internal for a database on the host; forward ${VAR} passwords
# with -e VAR in docker run.

sources:
  - id: local_pg
    url: jdbc:postgresql://localhost:5432/myapp
    username: postgres
    password: ${PG_PASSWORD}
    driver: postgres-jdbc
    # poolMaxConnections: 10   # optional; ignored for jdbc:sqlite: (forced to 1)

  - id: local_mysql
    url: jdbc:mysql://localhost:3306/myapp
    username: root
    password: ${MYSQL_PASSWORD}
    driver: mysql-jdbc

# Maven repositories for drivers. Omit the whole section to use Maven Central.
# When present, this section REPLACES Central (no implicit fallback): declare
# Central explicitly to keep using it — with `id: central` so that already
# cached drivers stay reusable. `id` defaults to "central"; `username` and
# `password` are optional (HTTP basic auth) and are interpolated like every
# other value. `url` must be the full repository base (http://, https:// or
# file://); nothing is appended to it.
# repositories:
#   - id: internal
#     url: https://artifactory.corp.example/artifactory/maven-virtual/
#     username: ${MAVEN_USER}
#     password: ${MAVEN_PASS}

# Drivers outside the built-in catalog (postgres-jdbc, mysql-jdbc, mariadb-jdbc,
# sqlite-jdbc, mssql-jdbc, oracle-jdbc). `className` may be omitted to inherit
# the built-in one when overriding just the pinned version. `repository` is
# optional and must reference a declared repository id.
# drivers:
#   - id: exotico-jdbc
#     className: com.exotico.Driver
#     repository: internal
#     maven: [{ groupId: com.exotico, artifactId: driver, version: "1.2.3" }]

# Tools are enabled per source. Omit the whole `tools:` section to default to
# execute_sql + search_objects (readonly=true, maxRows=100) on every source.
tools:
  - { name: execute_sql, source: local_pg, readonly: true, maxRows: 100 }
  - { name: search_objects, source: local_pg }
  - { name: explain_sql, source: local_pg }    # opt-in
  - { name: health_check, source: local_pg }   # opt-in
  - { name: database_info, source: local_pg }  # opt-in
  - { name: execute_sql, source: local_mysql, readonly: true, maxRows: 100 }
  - { name: search_objects, source: local_mysql }
